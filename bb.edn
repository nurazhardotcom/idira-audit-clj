{:paths ["src" "test"]
 :tasks
 {test {:doc "Run all clojure.test suites (rules, policy, HTTP integration)"
        :task (do (require 'pam-audit.rules-test
                           'pam-audit.policy-test
                           'pam-audit.integration-test)
                  (let [{:keys [fail error]}
                        (clojure.test/run-tests 'pam-audit.rules-test
                                                'pam-audit.policy-test
                                                'pam-audit.integration-test)]
                    (System/exit (if (zero? (+ fail error)) 0 1))))}
  audit-demo {:doc "Audit the built-in mock PAM API (deterministic EDN)"
              :requires ([pam-audit.main :as main])
              :task (main/-main "audit" "--mock")}
  audit-idsvc {:doc "Audit the sibling idsvc via its /inventory endpoint"
               :requires ([pam-audit.main :as main])
               :task (main/-main "audit" "--idsvc")}
  check-native {:doc "Report GraalVM native-image readiness"
                :requires ([pam-audit.main :as main])
                :task (main/-main "check-native")}}}
